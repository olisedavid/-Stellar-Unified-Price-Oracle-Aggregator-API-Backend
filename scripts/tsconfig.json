{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "outDir": "../dist/scripts"
  },
  "include": ["./**/*.ts"],
  "exclude": ["../node_modules", "../dist"]
}
